import 'package:flutter/material.dart';
import 'database_helper.dart';

class SubmitCourseScreen extends StatefulWidget {
  @override
  _SubmitCourseScreenState createState() => _SubmitCourseScreenState();
}

class _SubmitCourseScreenState extends State<SubmitCourseScreen> {
  final _formKey = GlobalKey<FormState>();
  final TextEditingController _userIdController = TextEditingController();
  final TextEditingController _marksController = TextEditingController();
  String? _selectedCourse;
  int? _semester;
  int? _creditHours;

  List<String> courses = [
    "OOP",
    "AI",
    "App Development",
    "Compiler Construction",
    "Information Security",
    "Operating System"
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Submit Course")),
      body: Padding(
        padding: const EdgeInsets.all(16.0),
        child: Form(
          key: _formKey,
          child: Column(
            children: [
              TextFormField(
                controller: _userIdController,
                keyboardType: TextInputType.number,
                decoration: InputDecoration(labelText: "User ID"),
                validator: (value) => value!.isEmpty ? "Enter user ID" : null,
              ),
              DropdownButtonFormField<String>(
                value: _selectedCourse,
                items: courses.map((course) {
                  return DropdownMenuItem(value: course, child: Text(course));
                }).toList(),
                onChanged: (val) => setState(() => _selectedCourse = val),
                decoration: InputDecoration(labelText: "Course Name"),
                validator: (value) =>
                value == null ? "Select a course" : null,
              ),
              DropdownButtonFormField<int>(
                value: _semester,
                items: List.generate(8, (index) => index + 1).map((sem) {
                  return DropdownMenuItem(value: sem, child: Text("Semester $sem"));
                }).toList(),
                onChanged: (val) => setState(() => _semester = val),
                decoration: InputDecoration(labelText: "Semester No"),
              ),
              DropdownButtonFormField<int>(
                value: _creditHours,
                items: List.generate(4, (index) => index + 1).map((ch) {
                  return DropdownMenuItem(value: ch, child: Text("$ch Credit Hour"));
                }).toList(),
                onChanged: (val) => setState(() => _creditHours = val),
                decoration: InputDecoration(labelText: "Credit Hours"),
              ),
              TextFormField(
                controller: _marksController,
                keyboardType: TextInputType.number,
                decoration: InputDecoration(labelText: "Marks"),
                validator: (value) => value!.isEmpty ? "Enter marks" : null,
              ),
              SizedBox(height: 20),
              ElevatedButton(
                onPressed: () async {
                  if (_formKey.currentState!.validate()) {
                    await DatabaseHelper.instance.insertCourse({
                      'user_id': int.parse(_userIdController.text),
                      'course_name': _selectedCourse!,
                      'semester_no': _semester!,
                      'credit_hours': _creditHours!,
                      'marks': int.parse(_marksController.text),
                      'synced': 0,
                    });
                    Navigator.pushNamed(context, '/submitted');
                  }
                },
                child: Text("Submit"),
              ),
            ],
          ),
        ),
      ),
    );
  }
}
