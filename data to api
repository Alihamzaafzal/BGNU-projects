  import 'package:flutter/material.dart';
import 'database_helper.dart';
import 'package:http/http.dart' as http;

class SubmittedCoursesScreen extends StatefulWidget {
  @override
  _SubmittedCoursesScreenState createState() => _SubmittedCoursesScreenState();
}

class _SubmittedCoursesScreenState extends State<SubmittedCoursesScreen> {
  List<Map<String, dynamic>> _courses = [];

  @override
  void initState() {
    super.initState();
    _loadCourses();
  }

  Future<void> _loadCourses() async {
    final data = await DatabaseHelper.instance.getAllCourses();
    setState(() {
      _courses = data;
    });
  }

  Future<void> _syncData() async {
    for (var course in _courses.where((c) => c['synced'] == 0)) {
      final response = await http.post(
        Uri.parse('https://devtechtop.com/management/public/api/insert_data'),
        body: {
          'user_id': course['user_id'].toString(),
          'course_name': course['course_name'],
          'semester_no': course['semester_no'].toString(),
          'credit_hours': course['credit_hours'].toString(),
          'marks': course['marks'].toString(),
        },
      );

      if (response.statusCode == 200) {
        await DatabaseHelper.instance.markAsSynced(course['id']);
      }
    }
    await _loadCourses();
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text("Sync complete!")));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Submitted Courses")),
      body: _courses.isEmpty
          ? Center(child: Text("No data submitted"))
          : ListView.builder(
        itemCount: _courses.length,
        itemBuilder: (context, index) {
          final course = _courses[index];
          return ListTile(
            title: Text("${course['course_name']} - ${course['marks']} marks"),
            subtitle: Text("User ID: ${course['user_id']} | Semester: ${course['semester_no']} | Synced: ${course['synced']}"),
          );
        },
      ),
      bottomNavigationBar: Padding(
        padding: const EdgeInsets.all(8.0),
        child: ElevatedButton(
          onPressed: _syncData,
          child: Text("Sync All"),
        ),
      ),
    );
  }
}
