  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text('Baba Guru Nanak University')),
      body: GoogleMap(
        initialCameraPosition: CameraPosition(
          target: universityLocation,
          zoom: 16,
